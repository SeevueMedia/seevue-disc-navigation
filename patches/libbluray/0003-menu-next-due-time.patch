+/* The timers _animate() and _run_timers() check, as due times. */
+int64_t gc_next_due(GRAPHICS_CONTROLLER *gc)
+{
+    int64_t due = -1;
+
+    if (!gc) {
+        return -1;
+    }
+
+    bd_mutex_lock(&gc->mutex);
+
+    if (gc->ig_open) {
+        if (gc->out_effects && gc->effect_idx < gc->out_effects->num_effects) {
+            due = gc->next_effect_time + (int64_t)gc->out_effects->effect[gc->effect_idx].duration;
+        } else if (gc->in_effects && gc->effect_idx < gc->in_effects->num_effects) {
+            due = gc->next_effect_time + (int64_t)gc->in_effects->effect[gc->effect_idx].duration;
+        } else if (gc->button_animation_running) {
+            due = gc->next_effect_time + gc->frame_interval;
+        }
+        /* _run_timers() fires once the clock is past the time-out */
+        if (gc->user_timeout && (due < 0 || gc->user_timeout + 1 < due)) {
+            due = gc->user_timeout + 1;
+        }
+    }
+
+    bd_mutex_unlock(&gc->mutex);
+
+    return due;
 }
 
