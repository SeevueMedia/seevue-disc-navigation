+int64_t bd_menu_next_due_ms(BLURAY *bd)
+{
+    int64_t result = -2;
+
+    if (!bd) {
+        return -2;
+    }
+
+    bd_mutex_lock(&bd->mutex);
+
+    if (bd->title_type == title_hdmv) {
+        if (!bd->hdmv_suspended) {
+            /* the HDMV VM runs on the next read */
+            result = 0;
+        } else if (!(bd->gc_status & GC_STATUS_ANIMATE)) {
+            /* reads run the graphics controller's timers only while it animates */
+            result = -1;
+        } else {
+            int64_t due = gc_next_due(bd->graphics_controller);
+            if (due < 0) {
+                result = -1;
+            } else {
+                int64_t now = (int64_t)bd_get_scr();
+                result = due <= now ? 0 : (due - now + 89) / 90;
+            }
+        }
+    }
 
+    bd_mutex_unlock(&bd->mutex);
+
+    return result;
+}
