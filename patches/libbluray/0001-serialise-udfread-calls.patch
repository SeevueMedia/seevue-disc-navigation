 #include "file/file.h"
 #include "util/macro.h"
 #include "util/mutex.h"
+
+#include <pthread.h>
+
+/* libudfread is not safe for concurrent use of one image, and BD-J
+ * copies its files (VFS cache) from Java threads while the player reads the
+ * stream. Serialise every libudfread call (block reads below keep their own
+ * lock). Without this, BD-J start-up failed intermittently: the disc's
+ * application found a cached image corrupt ("failed: Addendum.png"). */
+static pthread_mutex_t udf_call_lock = PTHREAD_MUTEX_INITIALIZER;
+#define UDF_LOCKED(expr) (pthread_mutex_lock(&udf_call_lock), _udf_r = (expr), pthread_mutex_unlock(&udf_call_lock), _udf_r)
 #include "util/logging.h"
 
 #ifdef HAVE_LIBUDFREAD
