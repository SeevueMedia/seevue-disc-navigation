+/* Reads a whole information file into memory; NULL if it cannot be read. */
+#define IFO_COMPARE_MAX (16 * 1024 * 1024)
+static uint8_t *ifoReadWhole(dvd_reader_t *ctx, int title, int backup, size_t *size) {
+  dvd_file_t *file = DVDOpenFile(ctx, title, backup ? DVD_READ_INFO_BACKUP_FILE
+                                                    : DVD_READ_INFO_FILE);
+  if(!file)
+    return NULL;
+  ssize_t blocks = DVDFileSize(file);
+  uint8_t *data = NULL;
+  if(blocks > 0 && (size_t)blocks * DVD_VIDEO_LB_LEN <= IFO_COMPARE_MAX) {
+    *size = (size_t)blocks * DVD_VIDEO_LB_LEN;
+    data = malloc(*size);
+    if(data && (DVDFileSeek(file, 0) != 0 || DVDReadBytes(file, data, *size) != (ssize_t)*size)) {
+      free(data);
+      data = NULL;
+    }
+  }
+  DVDCloseFile(file);
+  return data;
+}
+
+/* An information file and its backup are identical copies. When they differ
+   one of them is damaged: use the backup if it reads with fewer failed checks
+   than the information file, which libdvdread would otherwise accept as long as
+   its header still reads. */
+static int ifoPreferBackup(dvd_reader_t *ctx, int title) {
+  size_t ifo_size = 0, bup_size = 0;
+  uint8_t *ifo = ifoReadWhole(ctx, title, 0, &ifo_size);
+  uint8_t *bup = ifoReadWhole(ctx, title, 1, &bup_size);
+  int differ = ifo && bup && (ifo_size != bup_size || memcmp(ifo, bup, ifo_size) != 0);
+  free(ifo);
+  free(bup);
+  if(!differ)
+    return 0;
+  ifo_handle_t *a = ifoOpenFileOrBackup(ctx, title, 0);
+  ifo_handle_t *b = ifoOpenFileOrBackup(ctx, title, 1);
+  int prefer = b && (!a || PRIV(b)->check_failures < PRIV(a)->check_failures);
+  Log1(ctx, "%s for title %d differs from its backup; using the %s",
+       title ? "VTS IFO" : "VMG IFO", title, prefer ? "backup" : "IFO");
+  ifoClose(a);
+  ifoClose(b);
+  return prefer;
+}
+
+/* Compares a title set's IFO with its backup once, and marks the backup for
+   use when it is the intact copy. */
+static void ifoCheckBackup(dvd_reader_t *ctx, int title) {
+  uint64_t *checked = title > 63 ? &ctx->ifoCheckedflags[0] : &ctx->ifoCheckedflags[1];
+  uint64_t bit = UINT64_C(1) << (title > 63 ? title - 64 : title);
+  if((*checked & bit) || ifoGetBupFlag(ctx, title))
+    return;
+  *checked |= bit;
+  if(ifoPreferBackup(ctx, title))
+    ifoSetBupFlag(ctx, title);
+}
