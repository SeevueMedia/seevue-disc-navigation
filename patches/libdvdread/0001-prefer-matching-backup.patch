        [0] for upper remaining VTS, [1] for the first Main + 63 VTS */
     uint64_t ifoBUPflags[2];
+  /* Title sets whose IFO was compared with its backup (bit per title). */
+  uint64_t ifoCheckedflags[2];
 };
 
